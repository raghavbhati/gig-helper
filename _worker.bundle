        reply = language === "en" ? "I hear you. If a platform deducted a penalty unfairly, do not let it go. Go to our 'Dispute Drafter' tab above, attach your order number or voice note, and I will generate a formal appeal citing weather and platform guidelines to get your money refunded." : "\u091A\u093F\u0902\u0924\u093E \u092E\u0924 \u0915\u0940\u091C\u093F\u090F\u0964 \u0905\u0917\u0930 \u0915\u0902\u092A\u0928\u0940 \u0928\u0947 \u0917\u0932\u0924 \u092A\u0947\u0928\u0932\u094D\u091F\u0940 \u0915\u093E\u091F\u0940 \u0939\u0948 \u0924\u094B \u091A\u0941\u092A \u092E\u0924 \u092C\u0948\u0920\u093F\u090F\u0964 \u090A\u092A\u0930 '\u0936\u093F\u0915\u093E\u092F\u0924 \u092A\u0924\u094D\u0930 \u0932\u093F\u0916\u0947\u0902' \u091F\u0948\u092C \u092A\u0930 \u091C\u093E\u090F\u0902, \u0905\u092A\u0928\u093E \u0906\u0930\u094D\u0921\u0930 \u0928\u0902\u092C\u0930 \u092C\u0924\u093E\u090F\u0902, \u0914\u0930 \u092E\u0948\u0902 \u0906\u092A\u0915\u0947 \u0932\u093F\u090F \u0924\u0941\u0930\u0902\u0924 \u0915\u0902\u092A\u0928\u0940 \u0915\u094B \u092D\u0947\u091C\u0928\u0947 \u0935\u093E\u0932\u093E \u0915\u093E\u0928\u0942\u0928\u0940 \u0905\u092A\u0940\u0932 \u092A\u0924\u094D\u0930 \u0924\u0948\u092F\u093E\u0930 \u0915\u0930 \u0926\u0942\u0902\u0917\u093E\u0964";
      } else if (msgLower.includes("scheme") || msgLower.includes("sarkari") || msgLower.includes("yojana") || msgLower.includes("bima") || msgLower.includes("insurance")) {
        reply = language === "en" ? "As an informal or gig worker, you are entitled to the government's e-Shram card which provides \u20B92 Lakh accident coverage for free, plus the State Gig Worker Welfare Fund. Check the 'Welfare Schemes' tab to verify your eligibility in 30 seconds." : "\u0906\u092A \u092D\u093E\u0930\u0924 \u0938\u0930\u0915\u093E\u0930 \u0915\u0947 \u0908-\u0936\u094D\u0930\u092E (e-Shram) \u0915\u093E\u0930\u094D\u0921 \u0915\u0947 \u0939\u0915\u0926\u093E\u0930 \u0939\u0948\u0902, \u091C\u093F\u0938\u092E\u0947\u0902 \u092E\u0941\u092B\u094D\u0924 \u20B92 \u0932\u093E\u0916 \u0915\u093E \u0926\u0941\u0930\u094D\u0918\u091F\u0928\u093E \u092C\u0940\u092E\u093E \u092E\u093F\u0932\u0924\u093E \u0939\u0948\u0964 \u0907\u0938\u0915\u0947 \u0905\u0932\u093E\u0935\u093E \u0930\u093E\u091C\u094D\u092F \u0917\u093F\u0917 \u0935\u0930\u094D\u0915\u0930 \u092C\u094B\u0930\u094D\u0921 \u0915\u093E \u092B\u0902\u0921 \u092D\u0940 \u0939\u0948\u0964 \u090A\u092A\u0930 '\u0938\u0930\u0915\u093E\u0930\u0940 \u092F\u094B\u091C\u0928\u093E\u090F\u0902' \u091F\u0948\u092C \u092E\u0947\u0902 \u0926\u0947\u0916\u0947\u0902 \u0914\u0930 \u0924\u0941\u0930\u0902\u0924 \u0906\u0935\u0947\u0926\u0928 \u0915\u093E \u0924\u0930\u0940\u0915\u093E \u091C\u093E\u0928\u0947\u0902\u0964";
      } else {
        reply = language === "en" ? "Namaste! I am Saathi. You can ask me to audit your delivery payout slips, write complaint letters for unfair penalties, check government welfare schemes, or simplify confusing company rules. How can I assist your shift today?" : "\u0928\u092E\u0938\u094D\u0924\u0947 \u0938\u093E\u0925\u0940! \u092E\u0948\u0902 \u0906\u092A\u0915\u093E \u0915\u093E\u0928\u0942\u0928\u0940 \u0914\u0930 \u0915\u092E\u093E\u0908 \u0915\u093E \u0921\u093F\u091C\u093F\u091F\u0932 \u092E\u0926\u0926\u0917\u093E\u0930 \u0939\u0942\u0901\u0964 \u0906\u092A \u092E\u0941\u091D\u0938\u0947 \u0905\u092A\u0928\u0940 \u0915\u092E\u093E\u0908 \u0915\u093E \u0939\u093F\u0938\u093E\u092C \u091A\u0947\u0915 \u0915\u0930\u0935\u093E \u0938\u0915\u0924\u0947 \u0939\u0948\u0902, \u0917\u0932\u0924 \u0915\u091F\u0940 \u092A\u0947\u0928\u0932\u094D\u091F\u0940 \u0915\u0940 \u0936\u093F\u0915\u093E\u092F\u0924 \u0932\u093F\u0916\u0935\u093E \u0938\u0915\u0924\u0947 \u0939\u0948\u0902, \u092F\u093E \u0938\u0930\u0915\u093E\u0930\u0940 \u092C\u0940\u092E\u093E \u092F\u094B\u091C\u0928\u093E\u090F\u0902 \u0938\u092E\u091D \u0938\u0915\u0924\u0947 \u0939\u0948\u0902\u0964 \u092C\u0924\u093E\u0907\u090F \u0906\u091C \u092E\u0948\u0902 \u0906\u092A\u0915\u0940 \u0915\u094D\u092F\u093E \u092E\u0926\u0926 \u0915\u0930\u0942\u0901?";
      }
    }
    return new Response(JSON.stringify({ reply }), {
      headers: { "Content-Type": "application/json" }
